# ============================================================
# QUANTUM SENTINEL — FRONTEND ENVIRONMENT CONFIGURATION
# ============================================================

# Backend FastAPI Service URL
VITE_API_URL=http://127.0.0.1:8000

# Optional Map Tile Provider API Keys
# Default: ArcGIS World Dark Gray Base (Defense-grade, requires no API key, zero watermarks)
# If using CARTO basemaps with an authorized CARTO token, provide it below:
VITE_CARTO_API_KEY=

# Optional Mapbox API Key if using Mapbox tile layers:
VITE_MAPBOX_API_KEY=

# Optional Google Maps API Key if using Google Maps JS SDK:
VITE_GOOGLE_MAPS_API_KEY=

# Custom Tactical Map Tile Template URL (Optional override):
VITE_MAP_TILE_URL=
